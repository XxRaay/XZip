<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XZip.App.Pages.CreateArchivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:XZip.App.Converters"
    xmlns:abs="using:XZip.Core.Abstractions"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Создать архив" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Перетащите файлы или папки в зону ниже"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Drop zone + items list -->
        <Grid Grid.Row="1"
              AllowDrop="True"
              Drop="DropZone_Drop"
              DragOver="DropZone_DragOver">
            <Border CornerRadius="14"
                    BorderThickness="2"
                    BorderBrush="{ThemeResource XZipDropZoneBorderBrush}"
                    Background="{ThemeResource XZipDropZoneFillBrush}"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="20,16" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" Foreground="{ThemeResource XZipAccentBrush}" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                <Run Text="{x:Bind ViewModel.ItemCount, Mode=OneWay}" />
                                <Run Text=" файлов · " />
                                <Run Text="{x:Bind ViewModel.TotalSize, Mode=OneWay, Converter={StaticResource SizeConverter}}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Click="AddFiles_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" />
                                <TextBlock Text="Добавить файлы" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Click="AddFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" />
                                <TextBlock Text="Добавить папку" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Click="Clear_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" />
                                <TextBlock Text="Очистить" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView Grid.Row="1"
                              x:Name="SourcesList"
                              ItemsSource="{x:Bind ViewModel.SourcePaths, Mode=OneWay}"
                              Margin="12,0,12,12"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid Padding="0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7C3;" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Compression settings -->
        <Border Grid.Row="2"
                CornerRadius="12"
                Padding="20,16"
                Background="{ThemeResource XZipSurfaceBrush}"
                BorderBrush="{ThemeResource XZipSurfaceStrokeBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="20" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                    <TextBlock Text="Формат" Style="{StaticResource CaptionTextBlockStyle}" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableFormats, Mode=OneTime}"
                              SelectedItem="{x:Bind ViewModel.Format, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                    <TextBlock>
                        <Run Text="Уровень сжатия: " />
                        <Run Text="{x:Bind ViewModel.CompressionLevel, Mode=OneWay}" />
                    </TextBlock>
                    <Slider Minimum="0" Maximum="9"
                            StepFrequency="1"
                            TickFrequency="1"
                            TickPlacement="Outside"
                            Value="{x:Bind ViewModel.CompressionLevel, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                    <TextBlock Text="Потоков" Style="{StaticResource CaptionTextBlockStyle}" />
                    <NumberBox Minimum="1" Maximum="64"
                               SpinButtonPlacementMode="Inline"
                               Value="{x:Bind ViewModel.MaxParallelism, Mode=TwoWay}" />
                </StackPanel>

                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             PlaceholderText="Путь сохранения архива…"
                             Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Click="ChooseOutput_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8DA;" />
                            <TextBlock Text="Обзор…" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="2"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      ColumnSpacing="12"
                      Visibility="{x:Bind ViewModel.IsZipFormat, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Пароль ZIP" Style="{StaticResource CaptionTextBlockStyle}" />
                        <PasswordBox PlaceholderText="Введите пароль для архива"
                                     Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              VerticalAlignment="Bottom"
                              IsChecked="{x:Bind ViewModel.UseAesEncryption, Mode=TwoWay}"
                              Content="AES-256" />
                </Grid>
            </Grid>
        </Border>

        <!-- Action row -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ProgressBar Minimum="0" Maximum="100"
                             Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}"
                             ShowError="False" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}">
                    <Run Text="{x:Bind ViewModel.ProgressItem, Mode=OneWay}" />
                    <Run Text=" · " />
                    <Run Text="{x:Bind ViewModel.ProgressSpeed, Mode=OneWay}" />
                    <Run Text=" · " />
                    <Run Text="{x:Bind ViewModel.ProgressEta, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.CompressCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74E;" />
                    <TextBlock Text="Сжать" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
