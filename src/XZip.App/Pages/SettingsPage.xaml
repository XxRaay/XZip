<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XZip.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abs="using:XZip.Core.Abstractions"
    xmlns:svc="using:XZip.App.Services"
    xmlns:ui="using:Microsoft.UI.Xaml">

    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Stretch">
            <TextBlock Text="Настройки" Style="{StaticResource TitleTextBlockStyle}" />

            <Border CornerRadius="12" Padding="16"
                    Background="{ThemeResource XZipSurfaceBrush}"
                    BorderBrush="{ThemeResource XZipSurfaceStrokeBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Внешний вид" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Тема" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" MinWidth="180"
                                  ItemsSource="{x:Bind ViewModel.Themes}"
                                  SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}"
                                  SelectionChanged="Theme_SelectionChanged" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Фоновый эффект" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" MinWidth="180"
                                  ItemsSource="{x:Bind ViewModel.Backdrops}"
                                  SelectedItem="{x:Bind ViewModel.Backdrop, Mode=TwoWay}"
                                  SelectionChanged="Backdrop_SelectionChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="16"
                    Background="{ThemeResource XZipSurfaceBrush}"
                    BorderBrush="{ThemeResource XZipSurfaceStrokeBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Поведение" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Формат по умолчанию" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" MinWidth="180"
                                  ItemsSource="{x:Bind ViewModel.Formats}"
                                  SelectedItem="{x:Bind ViewModel.DefaultFormat, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="16"
                    Background="{ThemeResource XZipSurfaceBrush}"
                    BorderBrush="{ThemeResource XZipSurfaceStrokeBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="О программе" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}">
                        <Run Text="XZip · версия " />
                        <Run Text="{x:Bind ViewModel.Version}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Современный архиватор на .NET 8 + WinUI 3"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
