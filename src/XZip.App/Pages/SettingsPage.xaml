<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XZip.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abs="using:XZip.Core.Abstractions"
    xmlns:svc="using:XZip.App.Services"
    xmlns:ui="using:Microsoft.UI.Xaml">

    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Stretch">
            <TextBlock x:Uid="Settings_TitleText" Style="{StaticResource TitleTextBlockStyle}" />

            <Border CornerRadius="12" Padding="16"
                    Background="{ThemeResource XZipSurfaceBrush}"
                    BorderBrush="{ThemeResource XZipSurfaceStrokeBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Settings_Section_Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Settings_ThemeLabel" Grid.Column="0" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" MinWidth="180"
                                  ItemsSource="{x:Bind ViewModel.Themes}"
                                  SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}"
                                  SelectionChanged="Theme_SelectionChanged" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Settings_BackdropLabel" Grid.Column="0" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" MinWidth="180"
                                  ItemsSource="{x:Bind ViewModel.Backdrops}"
                                  SelectedItem="{x:Bind ViewModel.Backdrop, Mode=TwoWay}"
                                  SelectionChanged="Backdrop_SelectionChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="16"
                    Background="{ThemeResource XZipSurfaceBrush}"
                    BorderBrush="{ThemeResource XZipSurfaceStrokeBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Settings_Section_Behavior" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Settings_DefaultFormatLabel" Grid.Column="0" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" MinWidth="180"
                                  ItemsSource="{x:Bind ViewModel.Formats}"
                                  SelectedItem="{x:Bind ViewModel.DefaultFormat, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Settings_LanguageLabel" Grid.Column="0" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  MinWidth="180"
                                  ItemsSource="{x:Bind ViewModel.Languages}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{x:Bind ViewModel.Language, Mode=TwoWay}" />
                    </Grid>

                    <InfoBar x:Uid="Settings_LanguageRestartHint"
                             IsOpen="True"
                             Severity="Informational"
                             IsClosable="False" />
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="16"
                    Background="{ThemeResource XZipSurfaceBrush}"
                    BorderBrush="{ThemeResource XZipSurfaceStrokeBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="Settings_AboutLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}">
                        <Run x:Uid="Settings_VersionPrefixRun" />
                        <Run Text="{x:Bind ViewModel.Version}" />
                    </TextBlock>
                    <TextBlock x:Uid="Settings_AboutDescription"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
