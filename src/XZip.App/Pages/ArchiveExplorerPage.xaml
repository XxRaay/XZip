<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XZip.App.Pages.ArchiveExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:XZip.App.ViewModels"
    xmlns:converters="using:XZip.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NotEmptyToVisible" Inverse="False" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Grid Grid.Row="0" Padding="20,12,20,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="Open_Click" ToolTipService.ToolTip="Открыть архив (Ctrl+O)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8E5;" />
                    <TextBlock Text="Открыть" />
                </StackPanel>
            </Button>

            <Button Grid.Column="1"
                    Click="ExtractAll_Click"
                    Visibility="{x:Bind ViewModel.ArchivePath, Mode=OneWay, Converter={StaticResource NotEmptyToVisible}}"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE7B8;" />
                    <TextBlock Text="Извлечь всё" />
                </StackPanel>
            </Button>

            <AppBarSeparator Grid.Column="2"
                             Visibility="{x:Bind ViewModel.ArchivePath, Mode=OneWay, Converter={StaticResource NotEmptyToVisible}}" />

            <Button Grid.Column="3"
                    Click="GoUp_Click"
                    Visibility="{x:Bind ViewModel.ArchivePath, Mode=OneWay, Converter={StaticResource NotEmptyToVisible}}"
                    ToolTipService.ToolTip="Вверх">
                <FontIcon Glyph="&#xE74A;" />
            </Button>

            <BreadcrumbBar Grid.Column="4"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           ItemsSource="{x:Bind ViewModel.Breadcrumbs}"
                           ItemClicked="Breadcrumb_Clicked"
                           Visibility="{x:Bind ViewModel.ArchivePath, Mode=OneWay, Converter={StaticResource NotEmptyToVisible}}" />

            <AutoSuggestBox Grid.Column="6"
                            QueryIcon="Find"
                            PlaceholderText="Поиск…"
                            Width="240"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{x:Bind ViewModel.ArchivePath, Mode=OneWay, Converter={StaticResource NotEmptyToVisible}}" />
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="20,0,20,0">

            <!-- Empty state / drop zone -->
            <Grid Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                  AllowDrop="True"
                  Drop="DropZone_Drop"
                  DragOver="DropZone_DragOver"
                  Background="Transparent">
                <Border CornerRadius="16"
                        BorderThickness="2"
                        BorderBrush="{ThemeResource XZipDropZoneBorderBrush}"
                        Background="{ThemeResource XZipDropZoneFillBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="60,40"
                        MinWidth="520">
                    <StackPanel HorizontalAlignment="Center" Spacing="14">
                        <FontIcon Glyph="&#xE8E5;" FontSize="56"
                                  Foreground="{ThemeResource XZipAccentBrush}" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   Text="Перетащите архив сюда" />
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="ZIP, 7z, TAR, TAR.GZ, TAR.BZ2" />
                        <Button HorizontalAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="Open_Click"
                                Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8E5;" />
                                <TextBlock Text="Открыть архив…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Loaded archive view -->
            <Grid Visibility="{x:Bind ViewModel.ArchivePath, Mode=OneWay, Converter={StaticResource NotEmptyToVisible}}">
                <ListView
                          x:Name="EntriesList"
                          ItemsSource="{x:Bind ViewModel.VisibleEntries, Mode=OneWay}"
                          SelectionMode="Extended"
                          SelectionChanged="Entries_SelectionChanged"
                          DoubleTapped="Entries_DoubleTapped"
                          CanDragItems="True"
                          DragItemsStarting="Entries_DragItemsStarting"
                          IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ArchiveEntryViewModel">
                            <Grid Padding="0,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          Glyph="{x:Bind IconGlyph}"
                                          FontSize="16"
                                          Foreground="{ThemeResource XZipAccentBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Name}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind SizeText}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind CompressedSizeText}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="4"
                                           Text="{x:Bind RatioText}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="5"
                                           Text="{x:Bind ModifiedText}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8" ColumnSpacing="12"
                                  Background="{ThemeResource SubtleFillColorTransparentBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="Имя" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                                <TextBlock Grid.Column="2" Text="Размер" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                                <TextBlock Grid.Column="3" Text="Сжатый" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                                <TextBlock Grid.Column="4" Text="Сжатие" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                                <TextBlock Grid.Column="5" Text="Изменён" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                </ListView>

                <Button HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,20"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        Click="ExtractSelected_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7B8;" />
                        <TextBlock x:Uid="ArchiveExplorer_ExtractSelected_Text" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Background="#80000000"
                    CornerRadius="12"
                    Padding="0"
                    Visibility="{x:Bind ViewModel.IsPasswordPromptVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Border MinWidth="420"
                            MaxWidth="520"
                            CornerRadius="12"
                            Padding="20"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="ArchiveExplorer_PasswordPrompt_Title"
                                       Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.PasswordPromptMessage, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="WrapWholeWords" />
                            <PasswordBox x:Uid="ArchiveExplorer_PasswordPrompt_PasswordBox"
                                         Password="{x:Bind ViewModel.PasswordInput, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="8">
                                <Button x:Uid="ArchiveExplorer_PasswordPrompt_CancelButton" Click="CancelPasswordPrompt_Click" />
                                <Button x:Uid="ArchiveExplorer_PasswordPrompt_OpenButton"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="SubmitPassword_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" Padding="20,8,20,12" ColumnSpacing="8"
              Background="{ThemeResource SubtleFillColorTransparentBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <ProgressRing Grid.Column="1"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Width="20" Height="20" />
        </Grid>
    </Grid>

</Page>
